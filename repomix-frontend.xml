                fill="none"
                stroke="white"
                stroke-width="2"
                stroke-linecap="round"
                :stroke-dasharray="circumference"
                :stroke-dashoffset="holding ? 0 : circumference"
                :style="{
                  transition: holding ? `stroke-dashoffset ${HOLD_MS}ms linear` : 'stroke-dashoffset 200ms ease-out',
                  opacity: holding ? 0.9 : 0
                }"
              />
            </svg>
          </button>
