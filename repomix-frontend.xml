        'bg-linear-to-br to-[#d5e2de]',
        weatherData.sidebarColor || 'from-[#0f8cd5]',
        sidebarCollapsed ? 'w-16' : 'w-60',
        sidebarOpen ? 'translate-x-0' : '-translate-x-full md:translate-x-0'
