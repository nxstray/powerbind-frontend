          </div>

                    <!-- Row 3: Room cards + Activity -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="md:col-span-2 bg-white rounded-2xl border border-gray-100 p-4 md:p-5">
