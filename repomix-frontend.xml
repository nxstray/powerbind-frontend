const app = createApp(App)

// Tangkap global error Vue (misal: variabel undefined di template)
app.config.errorHandler = (err, instance, info) => {
  console.error('Global Vue Error:', err)
  
  // Kirim ke backend Spring Boot agar masuk ke Grafana Loki
  api.post('/api/logs', { 
    level: 'ERROR', 
    message: `Vue Render Error: ${err.message} | Component Info: ${info}` 
  }).catch(() => {}) // Catch kosong agar jika server mati, frontend tidak crash
}

app.use(createPinia())
app.use(router)

app.mount('#app')
