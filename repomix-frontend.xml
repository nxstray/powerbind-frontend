import api from '@/utils/api'

// Handles the two admin-only API calls: the auto-generated ERD schema and
// the merged Backend/Frontend/IoT log stream (both proxied server-side).
const adminService = {
  async getErdSchema() {
    const res = await api.get('/api/admin/erd')
    return res.data.data
  },

  async queryLogs({ source = 'ALL', level, search, since = '1h', limit = 300 } = {}) {
    const res = await api.get('/api/admin/logs', {
      params: { source, level, search, since, limit },
    })
    return res.data.data
  },
}

export default adminService
