              <SparklesIcon :size="16" class="text-white animate-spin" />
            </div>
            <div class="pt-3 flex gap-1">
              <div v-for="i in 3" :key="i" class="w-2 h-2 rounded-full bg-gray-400 animate-bounce" :style="{ animationDelay: (i - 1) * 0.2 + 's' }" />
