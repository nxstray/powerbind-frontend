  --input: oklch(1 0 0 / 15%);
  --ring: oklch(0.556 0 0);
  --chart-1: oklch(0.488 0.243 264.376);
  --chart-2: oklch(0.696 0.17 162.48);
  --chart-3: oklch(0.769 0.188 70.08);
  --chart-4: oklch(0.627 0.265 303.9);
  --chart-5: oklch(0.645 0.246 16.439);
  --sidebar: oklch(0.205 0 0);
  --sidebar-foreground: oklch(0.985 0 0);
  --sidebar-primary: oklch(0.488 0.243 264.376);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.269 0 0);
  --sidebar-accent-foreground: oklch(0.985 0 0);
  --sidebar-border: oklch(1 0 0 / 10%);
  --sidebar-ring: oklch(0.556 0 0);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
    font-family: 'Source+Sans+3', sans-serif;
  }
}

/* Custom scrollbar — used in the chat area, history dropdown, and sidebar nav.
   Color follows the --accent-color set by the page (matches the weather/time theme),
   with #0f8cd5 as the fallback when the variable is not set. */
.custom-scroll {
  scrollbar-width: thin;
  scrollbar-color: color-mix(in srgb, var(--accent-color, #0f8cd5) 35%, transparent) transparent;
}
.custom-scroll::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
.custom-scroll::-webkit-scrollbar-track {
  background: transparent;
}
.custom-scroll::-webkit-scrollbar-thumb {
  background-color: color-mix(in srgb, var(--accent-color, #0f8cd5) 35%, transparent);
  border-radius: 9999px;
  transition: background-color 0.2s ease;
}
.custom-scroll::-webkit-scrollbar-thumb:hover {
  background-color: color-mix(in srgb, var(--accent-color, #0f8cd5) 60%, transparent);
}

/* Chat history item — thin gray border when idle, turns into the theme accent color
   when the item is hovered OR active (the currently open conversation) */
.conv-item {
  border-color: rgba(0, 0, 0, 0.06);
  transition: border-color 0.2s ease, background-color 0.2s ease;
}
.conv-item--dark {
  border-color: rgba(255, 255, 255, 0.08);
}
.conv-item:hover,
.conv-item.conv-item--active {
  border-color: color-mix(in srgb, var(--accent-color, #0f8cd5) 55%, transparent);
}

/* "Chat History" dropdown trigger button — gray border when idle, turns into the accent color
   on hover or while the dropdown is open (active) */
.history-trigger {
  border-color: rgba(0, 0, 0, 0.12);
  transition: border-color 0.2s ease, background-color 0.2s ease;
}
.history-trigger--dark {
  border-color: rgba(255, 255, 255, 0.2);
}
.history-trigger:hover,
.history-trigger.history-trigger--active {
  border-color: var(--accent-color, #0f8cd5);
}

/* Textarea chat input — no visible scrollbar, height follows content (auto-resized from JS) */
.chat-input-textarea {
  scrollbar-width: none;
}
.chat-input-textarea::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

/* Blinking cursor for the typewriter greeting animation */
.typewriter-cursor {
  display: inline-block;
  animation: blink-cursor 0.9s step-end infinite;
}
@keyframes blink-cursor {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}
